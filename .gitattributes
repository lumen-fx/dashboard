# Linguist has no grammar for candela or .lmn markup yet, so map them to the
# nearest languages: candela highlights well as Rust, .lmn as XML. XML is a
# data language and excluded from the stats by default, so .lmn needs
# linguist-detectable to count.
*.cdl linguist-language=Rust
*.lmn linguist-language=XML linguist-detectable
