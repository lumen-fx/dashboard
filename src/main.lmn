<root padding="24" gap="16" bg="#0b1420">
  <row height="40px" gap="12" align="center">
    <label class="title" text="Ops dashboard" />
    <spacer />
    <label class="caption" text="tick 0" bind-text="clock" />
    <button id="pause" class="ghost" width="96px" height="32px" text="Pause" bind-text="pause_label" />
  </row>
  <row height="110px" gap="12">
    <column class="stat" grow="1">
      <label class="stat-label" text="Requests / min" />
      <label class="stat-value" height="52px" text="0" bind-text="requests" />
    </column>
    <column class="stat" grow="1">
      <label class="stat-label" text="Active users" />
      <label class="stat-value" height="52px" text="0" bind-text="users" />
    </column>
    <column class="stat" grow="1">
      <label class="stat-label" text="Error rate" />
      <label class="stat-value accent" height="52px" text="0%" bind-text="errors" />
    </column>
  </row>
  <column class="card" padding="16" gap="10">
    <row gap="10" align="center">
      <label class="caption" width="90px" text="CPU" />
      <progress height="10px" grow="1" bind-value="cpu" max="100" />
      <label class="caption" width="48px" text="0%" text-align="end" bind-text="cpu_label" />
    </row>
    <row gap="10" align="center">
      <label class="caption" width="90px" text="Memory" />
      <progress height="10px" grow="1" bind-value="mem" max="100" />
      <label class="caption" width="48px" text="0%" text-align="end" bind-text="mem_label" />
    </row>
  </column>
  <label class="caption" height="20px" text="Recent activity" />
  <scroll grow="1">
    <for gap="4" each="activity" key="id">
      <row class="feed-row" height="34px" gap="10" align="center">
        <label class="feed-time" width="70px" text="{row.time}" />
        <label class="feed-text" grow="1" text="{row.text}" max-lines="1" wrap="none" />
      </row>
    </for>
  </scroll>
  <script src="main.lua" />
</root>
